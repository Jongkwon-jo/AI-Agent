# 이 파일을 복사해서 .env 로 이름을 바꾸고, 본인의 API 키를 넣으세요.
#   cp .env.example .env
# API 키 발급: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-여기에-본인-키를-넣으세요

# ----- vLLM (local_llm/ 폴더) 설정 -----
# SSH 터널로 연결한 주소 (기본값 그대로 두면 됩니다)
VLLM_BASE_URL=http://localhost:8100/v1
# vLLM 을 --api-key 옵션으로 실행했다면 그 값을 넣으세요. 아니면 EMPTY 그대로.
VLLM_API_KEY=EMPTY
# 비워두면 서버에 올라간 첫 번째 모델을 자동으로 사용합니다.
VLLM_MODEL=
